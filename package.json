{
  "name": "fin-box-electron-react",
  "version": "1.1.0",
  "private": true,
  "description": "FinBox rewritten with Electron, React and TypeScript.",
  "main": "dist-electron/main/main.js",
  "scripts": {
    "icon": "node scripts/generate-app-icon.cjs",
    "prebuild:electron": "node scripts/generate-app-icon.cjs",
    "dev": "npm run build:electron && concurrently -k \"vite --host 127.0.0.1 --strictPort\" \"wait-on tcp:5173 && node scripts/start-electron-dev.cjs\"",
    "build:electron": "esbuild src/main/main.ts src/preload.ts --bundle --platform=node --target=node24 --format=cjs --outdir=dist-electron --external:electron --external:electron-updater",
    "build": "npm run typecheck && vite build && npm run build:electron",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux",
    "release": "npm run build && electron-builder --publish always",
    "start": "electron .",
    "typecheck": "tsc --noEmit"
  },
  "build": {
    "appId": "com.finbox.desktop",
    "productName": "FinBox",
    "asar": true,
    "compression": "maximum",
    "electronLanguages": [
      "en-US",
      "zh-CN"
    ],
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "tuniren",
        "repo": "fin-box",
        "releaseType": "release"
      }
    ],
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "public/assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "public/assets/app-icon.ico"
    },
    "nsis": {
      "artifactName": "${productName}-Setup-${version}-${os}-${arch}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "FinBox",
      "installerIcon": "public/assets/app-icon.ico",
      "uninstallerIcon": "public/assets/app-icon.ico"
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}-${os}-${arch}.${ext}"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.finance",
      "artifactName": "${productName}-${version}-${os}-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office;Finance",
      "artifactName": "${productName}-${version}-${os}-${arch}.${ext}"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "latest",
    "antd": "latest",
    "echarts": "^6.1.0",
    "iconv-lite": "latest",
    "js-yaml": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "@types/js-yaml": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "concurrently": "latest",
    "cross-env": "latest",
    "electron": "42.2.0",
    "electron-builder": "latest",
    "esbuild": "latest",
    "typescript": "latest",
    "vite": "latest",
    "wait-on": "latest"
  }
}
